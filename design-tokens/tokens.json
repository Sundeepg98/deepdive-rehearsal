  "gap": {
    "$type": "dimension",
    "home": {
      "$description": "the home column stack, one slot per block -- audit P3-11. Originally each slot ALIASED the exact primitive that block already used, so the semantic layer moved no pixels. appeal/home-instrument reshapes the stack: `state` and `decision` are GONE (the one-line state moved into the status census, and the decision hero became a component inside `continue` rather than a stack member), and `continue` / `altitude` / `duo` are new. Slots still get their own name where they share a value -- three roles landing on the same number independently is the fact a normalisation pass needs and a shared var(--space-26) hides. Guarded by test/home_rhythm.py, which cross-checks this map against the stylesheet in BOTH directions.",
      "lead": {
        "$value": "{space.16}"
      },
      "continue": {
        "$value": "{space.26}",
        "$description": "the hero block: the question you were being interrogated on, the resume line, the one primary action"
      },
      "altitude": {
        "$value": "{space.26}",
        "$description": "the gauge -- readiness by interview tier"
      },
      "duo": {
        "$value": "{space.26}",
        "$description": "the paired row: still-shaky and this-week"
      },
      "rooms": {
        "$value": "{space.30}"
      },
      "section": {
        "$value": "{space.26}"
      },
      "telemetry": {
        "$value": "{space.26}"
      },
      "skip": {
        "$value": "{space.20}"
      }
    }
  },
  "measure": {
    "$type": "dimension",
    "$description": "content column widths",
    "home": {
      "$value": "{space.980}",
      "$description": "the home content column -- the stacked blocks share this width; var(--space-980) said 980, this says which column. Unchanged by appeal/home-instrument: the home now sits in the shell's stage slot, which is narrower than 980 at 1280 and reaches the measure only on a wide desktop -- which is exactly when a measure should bind"
    },
    "display": {
      "$value": "41ch",
      "$description": "the DISPLAY measure, and the rule it exists to state: display type takes a SHORTER measure than body type. The home hero is a question set at display size, and on a body measure it stretches into a heading instead of landing as something someone asked you. ch, not px, because the rule is about characters per line"
    }
  },
